<?xml version="1.0" encoding="utf-8"?>
<com.mystudio.app.FractionalFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_bg" />

    <!-- الطبقة السفلية: شريط التحميل (تظهر كل العناصر الأخرى فوقه) -->
    <LinearLayout
        android:id="@+id/loader_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:frx="0.5"
        app:fry="0.8561988330576484"
        >
        <View
            android:id="@+id/dot_1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_shape" />
        <View
            android:id="@+id/dot_2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_shape" />
        <View
            android:id="@+id/dot_3"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_shape" />
    </LinearLayout>

    <ImageView
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher_foreground"
        app:frx="0.5"
        app:fry="0.4769436673978232" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:maxWidth="320dp"
        android:text="زعيم الملاعب"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:fontFamily="sans-serif-black"
        android:textFontWeight="800"
        android:letterSpacing="0.000"
        app:frx="0.5"
        app:fry="0.7394339756367514" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:maxWidth="320dp"
        android:text="By mo.fashwan"
        android:textColor="#BCB6DC"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        android:textFontWeight="400"
        android:letterSpacing="0.000"
        app:frx="0.5"
        app:fry="0.9564142814538623" />

</com.mystudio.app.FractionalFrameLayout>
